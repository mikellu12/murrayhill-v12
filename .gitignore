# Environments. 1.2 GB between the two, and both rebuild from
# requirements.txt (GPU) and requirements-analysis.txt (laptop).
.venv/
.venv-gpu/

# Street View imagery is not redistributable. Google's terms cap caching at
# 30 days; derived profiles and metrics are ours to publish, the JPEGs are
# scratch. 199 MB, and uploading them would be a licence breach as well as
# a repo nobody can clone.
data/raw/svi/

# The same photographs, one step removed: the per-face panels draw Street
# View pixels under the overlay, and the dashboard embeds those panels as
# base64. Both are regenerated by make_dashboard.py and tools/face_samples.py
# from data that is on disk locally.
results/figures/face_samples/
results/dashboard.html

# Credentials. GMAPS_KEY lives here and must never leave the machine.
.env

# Local safety copies of artefacts that cannot be regenerated cheaply.
# Keep them on disk; they are not history.
*.bak

__pycache__/
*.pyc
.DS_Store
.claude/

# Street View imagery under any frame version. Google caps caching at 30 days
# and the JPEGs are not redistributable; only derived profiles are.
data/raw/svi_v12/
data/raw/svi_*/

# Superseded frames and scratch profile arrays. Kept on disk so a v12 result
# stays reproducible, but they are large binaries and not the current state.
data/processed/v12_*
data/processed/*.BACKUP-*.npz
data/processed/*.prev.npz
data/processed/azimuth_profiles_subset.npz
data/raw/v12_metadata.csv

# Derived report, regenerated by tools/build_sim_report.py in seconds.
results/sim_report.html
